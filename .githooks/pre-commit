#!/usr/bin/env bash
# ==============================================================================
# GIT PRE-COMMIT HOOK: Quality & Secret Leak Prevention
# ==============================================================================

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m' # No Color

echo "🔍 [Pre-Commit Hook] Running quality & security checks..."

# 1. Secret & Credential Leak Detection in Staged Files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -n "$STAGED_FILES" ]; then
    # Search staged files for potential raw live secrets
    if git diff --cached | grep -E -q "sk_live_[0-9a-zA-Z]{20,}|ghp_[0-9a-zA-Z]{30,}|BEGIN (RSA|OPENSSH) PRIVATE KEY"; then
        echo -e "${RED}❌ [SECURITY ERROR] Potential unredacted private key or API token detected in staged changes!${NC}"
        echo -e "${YELLOW}Please mask credentials using LogRedactor or remove them before committing.${NC}"
        exit 1
    fi
fi

# 2. Syntax check staged python files
for file in $STAGED_FILES; do
    if [[ "$file" == *.py ]]; then
        if [ -f "$file" ]; then
            python3 -m py_compile "$file" 2>/dev/null || {
                echo -e "${RED}❌ [SYNTAX ERROR] Python syntax error in: $file${NC}"
                exit 1
            }
        fi
    fi
done

echo -e "${GREEN}✅ [Pre-Commit Hook] All security and syntax checks passed!${NC}"
exit 0
